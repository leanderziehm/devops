FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        vim \
        git \
        tmux \
        curl \
        sudo \
        openssh-client \
        make \
        python3 \
        python3-pip \
        python3-venv \
        golang \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash dev \
    && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev

USER dev
WORKDIR /home/dev

CMD ["/bin/bash"]
